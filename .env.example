# ==============================================================================
# Campus Food Ordering System - Global Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend (apps/backend/.env)
# ------------------------------------------------------------------------------
# PostgreSQL Database Connection String (Direct or Supabase / Neon / AWS RDS)
DATABASE_URL="postgresql://postgres:your_password@db.your_supabase_ref.supabase.co:5432/postgres"

# Supabase Authentication & Storage (Optional if using self-hosted JWT)
SUPABASE_URL="https://your_supabase_ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_publishable_key_here"
SUPABASE_SECRET_KEY="sb_secret_your_secret_key_here"
SUPABASE_JWKS_URL="https://your_supabase_ref.supabase.co/auth/v1/.well-known/jwks.json"

# Server Configuration
PORT=4000
NODE_ENV=development

# JWT Authentication
JWT_SECRET="campus_food_jwt_secret_key_change_in_production_2026"
JWT_EXPIRES_IN="7d"

# AI Model Providers (For Kitchen AI Assistant & Sales Prediction)
ANTHROPIC_API_KEY="sk-ant-api03-your-anthropic-api-key"
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
AI_API_KEY="AIzaSyYourGeminiApiKeyHere"
NANOBANANA_API_KEY=""

# Allowed CORS Origins (Comma-separated or primary URL)
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Vendor Dashboard Web App (apps/web/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_WS_URL="http://localhost:4000"

# ------------------------------------------------------------------------------
# Student Mobile App (apps/mobile/.env)
# ------------------------------------------------------------------------------
# Note: For iOS Simulator use 'http://localhost:4000/api'
# Note: For Android Emulator use 'http://10.0.2.2:4000/api'
# Note: For Physical Mobile Device use your LAN IP 'http://192.168.1.X:4000/api'
EXPO_PUBLIC_API_URL="http://localhost:4000/api"
EXPO_PUBLIC_WS_URL="http://localhost:4000"
