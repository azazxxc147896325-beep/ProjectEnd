# ==============================================================================
# Campus Food Backend Environment Configuration (.env)
# ==============================================================================

# PostgreSQL Connection String (Supabase / Localhost / Neon)
DATABASE_URL="postgresql://postgres:your_password@db.your_supabase_ref.supabase.co:5432/postgres"

# Supabase Credentials (Optional)
SUPABASE_URL="https://your_supabase_ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_publishable_key_here"
SUPABASE_SECRET_KEY="sb_secret_your_secret_key_here"
SUPABASE_JWKS_URL="https://your_supabase_ref.supabase.co/auth/v1/.well-known/jwks.json"

# Server Port & Environment
PORT=4000
NODE_ENV=development

# JWT Secret & Token Duration
JWT_SECRET="campus_food_jwt_secret_key_change_in_production_2026"
JWT_EXPIRES_IN="7d"

# AI Assistant API Keys (Anthropic Claude & Google Gemini)
ANTHROPIC_API_KEY="sk-ant-api03-your-anthropic-api-key"
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
AI_API_KEY="AIzaSyYourGeminiApiKeyHere"
NANOBANANA_API_KEY=""

# Allowed CORS Origins
FRONTEND_URL="http://localhost:3000"
