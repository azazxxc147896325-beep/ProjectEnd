# ==============================================================================
# Campus Food Student Mobile App Environment Configuration (.env)
# ==============================================================================

# Backend API URL:
# - iOS Simulator: http://localhost:4000/api
# - Android Emulator: http://10.0.2.2:4000/api
# - Physical Device (Expo Go): http://<YOUR_LAN_IP>:4000/api (e.g. http://192.168.1.50:4000/api)
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Backend WebSocket URL:
# - iOS Simulator: http://localhost:4000
# - Android Emulator: http://10.0.2.2:4000
# - Physical Device (Expo Go): http://<YOUR_LAN_IP>:4000
EXPO_PUBLIC_WS_URL=http://localhost:4000
