{
  "name": "campus-food-ordering-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Campus Food Ordering System Monorepo (Web, Mobile, Backend, Shared Types)",
  "scripts": {
    "dev:backend": "pnpm --filter @campus-food/backend dev",
    "dev:web": "pnpm --filter @campus-food/web dev",
    "dev:mobile": "pnpm --filter @campus-food/mobile start",
    "build": "pnpm --filter @campus-food/shared-types build && pnpm --filter @campus-food/backend build && pnpm --filter @campus-food/web build",
    "build:types": "pnpm --filter @campus-food/shared-types build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "prettier": "^3.5.1",
    "prisma": "^6.19.3",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.21.0"
}
