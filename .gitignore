# ==============================================================================
# Campus Food Ordering Monorepo - Git Ignore Rules
# ==============================================================================

# ---- Package Managers & Dependencies ----
node_modules/
.pnpm-store/
.npm/
.yarn/

# ---- Build & Output Artifacts ----
dist/
build/
out/
.next/
.turbo/
web-build/
*.tsbuildinfo
tsconfig.tsbuildinfo

# ---- Environment Variables & Secrets ----
.env
.env.*
.env*.local
*.pem
*.key
*.cert
*.crt

# Always keep template files
!.env.example
!.env.local.example
!.env.*.example

# ---- Mobile & Expo Framework ----
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
*.apk
*.aab
*.ipa

# ---- Testing & Coverage ----
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# ---- Logs & Debugging ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Operating System Specific ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ---- IDE & Editor Configs ----
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---- Temporary & Scratch Files ----
tmp/
temp/
.cache/
postgres_data/
